# Copy to web/.env.local (git-ignored) and restart `npm run dev`.

# Signs session cookies and the daily IP-hash salt. Required in production (>= 32 chars), e.g.:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
# In development a secret is generated once into web/.data/dev-auth-secret.
AUTH_SECRET=

# Public URL of the site; needed behind a proxy so OAuth redirect URIs and email links are right. Defaults to the request host.
# APP_URL=https://cosmictriad.com

# Where the Spring engine listens. The browser never calls it directly.
ENGINE_URL=http://localhost:8080

# ---- Limits (SPEC section 7). Tune without a release. ----
FREE_READINGS_PER_IP=5      # anonymous readings per hashed IP per day (identical inputs are not counted twice)
SIGNUPS_PER_IP=3            # new accounts per hashed IP per day
MESSAGE_CAP=20              # messages one credit buys
MAX_CHARS=500               # characters per conversation message
CALENDAR_DAYS=7

# ---- Email verification (SPEC section 5). Without these, the link is printed to the server log and,
#      outside production, returned to the sign-in sheet as a "Development: open the verification link" button.
RESEND_API_KEY=
MAIL_FROM=Cosmic Triad <no-reply@cosmictriad.com>

# ---- Payments (SPEC section 6). Without STRIPE_SECRET_KEY, development simulates purchases; production returns 503.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
#   Stripe Dashboard → Products: one Price per package. Amounts are read from Stripe at startup; the *_EUR values
#   below are only the placeholders shown while the ids are empty.
STRIPE_PRICE_SINGLE=
STRIPE_PRICE_PACK=
STRIPE_PRICE_MONTHLY=
PACKAGE_SINGLE_EUR=2.99
PACKAGE_PACK_EUR=9.99
PACKAGE_MONTHLY_EUR=14.99
MONTHLY_PACKAGE=off         # on = offer the monthly package (10 conversations + unlimited questions for 30 days)

# ---- Privacy notice (/ro/privacy). Required before the site is public. ----
PRIVACY_CONTROLLER=
PRIVACY_EMAIL=
# Who hosts the site, e.g. "Oracle Cloud Infrastructure (Oracle), server in Frankfurt, Germany (EU)"
PRIVACY_HOSTING=
# The AI provider used for the texts, e.g. "OpenRouter, Inc."
PRIVACY_AI=

# ---- Google / Facebook sign-in: hidden unless SOCIAL_LOGIN=on AND the keys below are set ----
SOCIAL_LOGIN=off

# Google: https://console.cloud.google.com/apis/credentials → OAuth client ID → Web application
#   Authorized redirect URI: http://localhost:3000/api/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Facebook: https://developers.facebook.com/apps → Facebook Login → Settings
#   Valid OAuth Redirect URI: http://localhost:3000/api/auth/facebook/callback
FACEBOOK_CLIENT_ID=
FACEBOOK_CLIENT_SECRET=
# FACEBOOK_GRAPH_VERSION=v23.0

# Optional: own geocoder instance (Open-Meteo API compatible). Default: https://geocoding-api.open-meteo.com/v1/search
# GEOCODER_URL=

# Optional: where users.json and the dev secret live. Default: web/.data
# ASTRO_DATA_DIR=

# ---- Operations. A daily summary (accounts, questions, conversations, tokens, credits) is logged at 06:00 UTC and
#      emailed to OPS_EMAIL when set (needs the mail settings above). OPS_TOKEN enables GET /api/ops/summary
#      with "Authorization: Bearer <token>"; leave empty to keep that route off.
OPS_EMAIL=
OPS_TOKEN=
