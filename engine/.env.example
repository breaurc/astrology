# Copy to engine/.env (git-ignored) and fill in. Loaded by Spring via spring.config.import.
ASTRO_LLM_PROVIDER=openrouter
ASTRO_LLM_API_KEY=sk-or-...
ASTRO_LLM_MODEL=deepseek/deepseek-v4-flash
# Optional: ASTRO_LLM_REASONING=on (on | low | medium | high | off), ASTRO_LLM_REASONING_TOKENS=1500 (thinking budget on top of each cap)
# Optional: ASTRO_LLM_FALLBACK_MODEL=, ASTRO_LLM_TIMEOUT_MS=30000, ASTRO_LLM_DAILY_TOKENS=0 (0 = unlimited)
