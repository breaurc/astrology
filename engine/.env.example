# Copy to engine/.env (git-ignored) and fill in. Loaded by Spring via spring.config.import.
ASTRO_LLM_PROVIDER=openrouter
ASTRO_LLM_API_KEY=sk-or-...
ASTRO_LLM_MODEL=deepseek/deepseek-v4-flash
# Optional: ASTRO_LLM_FALLBACK_MODEL=, ASTRO_LLM_TIMEOUT_MS=20000, ASTRO_LLM_DAILY_TOKENS=0 (0 = unlimited)
