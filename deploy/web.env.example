# Copy to deploy/web.env on the server (never commit it). Runtime settings for the Next.js site.
# Generate with:  openssl rand -base64 48
AUTH_SECRET=

PRIVACY_CONTROLLER=
PRIVACY_EMAIL=
PRIVACY_HOSTING=Oracle Cloud Infrastructure (Oracle), server in Frankfurt, Germany (EU)
PRIVACY_AI=OpenRouter, Inc. (USA) and the hosting provider it routes the DeepSeek V4 Flash model to, with no storage or training on the data

# Limits (SPEC section 7)
FREE_READINGS_PER_IP=5
SIGNUPS_PER_IP=3
MESSAGE_CAP=20
MAX_CHARS=500

# Email verification links (Resend). Required in production: without a mail provider nobody can activate an email account.
RESEND_API_KEY=
MAIL_FROM=Cosmic Triad <no-reply@cosmictriad.com>

# Stripe (live keys). Webhook endpoint: https://<domain>/api/webhooks/stripe, event checkout.session.completed
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_SINGLE=
STRIPE_PRICE_PACK=
STRIPE_PRICE_MONTHLY=
MONTHLY_PACKAGE=off

SOCIAL_LOGIN=off
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
FACEBOOK_CLIENT_ID=
FACEBOOK_CLIENT_SECRET=

# ---- Operations. A daily summary (accounts, questions, conversations, tokens, credits) is logged at 06:00 UTC and
#      emailed to OPS_EMAIL when set (needs the mail settings above). OPS_TOKEN enables GET /api/ops/summary
#      with "Authorization: Bearer <token>"; leave empty to keep that route off.
OPS_EMAIL=
OPS_TOKEN=
