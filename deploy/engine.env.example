# Copy to deploy/engine.env on the server (never commit it). Runtime settings for the Spring engine.
ASTRO_LLM_PROVIDER=openrouter
ASTRO_LLM_API_KEY=sk-or-...
ASTRO_LLM_MODEL=deepseek/deepseek-v4-flash
# Hidden thinking of a reasoning model: on | low | medium | high | off, with its token budget on top of each answer cap
ASTRO_LLM_REASONING=on
ASTRO_LLM_REASONING_TOKENS=1500
# Tried when the main model errors or times out (HLD section 6)
ASTRO_LLM_FALLBACK_MODEL=
# Per-call timeout and the daily token ceiling that stops answer/chat (readings fall back to templates)
ASTRO_LLM_TIMEOUT_MS=30000
ASTRO_LLM_DAILY_TOKENS=2000000
